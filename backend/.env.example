DB_HOST=localhost
DB_PORT=5432
DB_NAME=pqfms_db
DB_USER=postgres
DB_PASSWORD=
PORT=5000
NODE_ENV=development
# Optional server-controlled mode: OPERATIONAL, SYNTHETIC_TEST or DEMO.
# If omitted, production defaults to OPERATIONAL and non-production defaults to SYNTHETIC_TEST.
# DATA_PROVENANCE_MODE=SYNTHETIC_TEST
# A non-operational mode in production also requires explicit acknowledgement:
# ALLOW_NON_OPERATIONAL_PROVENANCE_MODE=true
JWT_SECRET=GENERATED_BY_SETUP_SCRIPT
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
INTERNAL_SERVICE_TOKEN=GENERATED_BY_SETUP_SCRIPT
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
ANALYTICS_URL=http://localhost:5001
STAFFED_STATIONS=1
