# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pqfms_db
DB_USER=postgres
DB_PASSWORD=

# Backend
PORT=5000
NODE_ENV=development
JWT_SECRET=GENERATED_BY_SETUP_SCRIPT
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
INTERNAL_SERVICE_TOKEN=GENERATED_BY_SETUP_SCRIPT

# SMS (set SMS_ENABLED=true only when Twilio values are configured)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Wait-time analytics
ANALYTICS_URL=http://localhost:5001
STAFFED_STATIONS=1

# Frontend Vite environment values
VITE_API_BASE_URL=http://localhost:5000
VITE_ANALYTICS_BASE_URL=http://localhost:5001
VITE_SOCKET_URL=http://localhost:5000
