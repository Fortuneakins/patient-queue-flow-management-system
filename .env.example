# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pqfms_db
DB_USER=postgres
DB_PASSWORD=
# Optional local analytics identity. When unset, local development reuses DB_USER/DB_PASSWORD;
# production requires a distinct read-only analytics account.
# ANALYTICS_DB_USER=pqfms_analytics
# ANALYTICS_DB_PASSWORD=
# ANALYTICS_DATABASE_URL=
# Local development can use false. Production requires DB_SSL=true and a trusted server certificate.
DB_SSL=false
# Python analytics uses verify-full in production by default; local development can use prefer.
DB_SSLMODE=prefer

# Backend
PORT=5000
NODE_ENV=development
# Server-only provenance policy. Production must use OPERATIONAL; non-production defaults to SYNTHETIC_TEST.
# Synthetic tests and demos must run in separate non-production environments.
# Allowed: OPERATIONAL, SYNTHETIC_TEST, DEMO. Never accept this from a browser/client.
# DATA_PROVENANCE_MODE=SYNTHETIC_TEST
# Production must not set ALLOW_NON_OPERATIONAL_PROVENANCE_MODE.
JWT_SECRET=GENERATED_BY_SETUP_SCRIPT
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173
# Configure 32+ random characters, independent of JWT_SECRET; required for production.
INTERNAL_SERVICE_TOKEN=GENERATED_BY_SETUP_SCRIPT
# Trust only a known reverse proxy hop count; leave 0 when connecting directly.
TRUST_PROXY_HOPS=0

# SMS (set SMS_ENABLED=true only when Twilio values are configured)
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Wait-time analytics
ANALYTICS_URL=http://localhost:5001
STAFFED_STATIONS=1
# Operational review prompt threshold (whole minutes, 1–1440); does not change triage priority.
DELAY_REVIEW_THRESHOLD_MINUTES=60

# Frontend Vite environment values
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
