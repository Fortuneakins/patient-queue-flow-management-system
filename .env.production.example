# Copy to .env.production on the deployment host. Never commit the real file.
# Replace every example value and provision secrets through your organisation's secret manager.
# PUBLIC_DOMAIN must resolve publicly to this server; inbound TCP 80/443 must be allowed.
PUBLIC_DOMAIN=clinic.example.org
TLS_CONTACT_EMAIL=it-operations@example.org

# Managed PostgreSQL endpoint with a trusted TLS certificate.
DB_HOST=postgres.example.org
DB_PORT=5432
DB_NAME=pqfms
DB_USER=pqfms_service
DB_PASSWORD=REPLACE_WITH_API_RUNTIME_DATABASE_SECRET

# Separate schema-owner account used only by the one-shot migration job.
# Do not use this account for the API or analytics application containers.
MIGRATION_DB_USER=pqfms_migrator
MIGRATION_DB_PASSWORD=REPLACE_WITH_MIGRATION_OWNER_DATABASE_SECRET

# Separate database principal for analytics. Grant CONNECT/USAGE and column-level
# SELECT only on required queue timing/provenance columns; do not grant writes.
ANALYTICS_DB_USER=pqfms_analytics
ANALYTICS_DB_PASSWORD=REPLACE_WITH_READ_ONLY_ANALYTICS_DATABASE_SECRET

# Generate independent, high-entropy secrets. Do not reuse values.
# Suggested local generation only: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=REPLACE_WITH_48_BYTE_RANDOM_SECRET
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_A_DIFFERENT_48_BYTE_RANDOM_SECRET

# Production is locked to operational provenance. Run synthetic tests in a separate environment.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Workload fallback applies only to displayed capacity context; configure shifts for real capacity.
STAFFED_STATIONS=1

# Operational review prompt threshold (whole minutes, 1–1440); never changes triage priority.
DELAY_REVIEW_THRESHOLD_MINUTES=60
